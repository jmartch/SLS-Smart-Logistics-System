enum DeliveryOutcome {
  DELIVERED
  FAILED
  RESCHEDULED
}

enum IncidentStatus {
  OPEN
  RESOLVED
  CLOSED
}

model DeliveryOperation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  requestId      String
  actorUserId    String   @db.Uuid
  commandType    String
  targetId       String   @db.Uuid
  requestHash    String
  resultSnapshot Json
  createdAt      DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  actorUser User   @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, requestId])
  @@index([tenantId])
  @@index([tenantId, targetId])
}

model DeliveryAttempt {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @db.Uuid
  routeStopId       String          @db.Uuid
  packageId         String          @db.Uuid
  courierId         String          @db.Uuid
  routeId           String?         @db.Uuid
  assignmentId      String?         @db.Uuid
  attemptNumber     Int
  outcome           DeliveryOutcome
  failureReasonCode String?
  notes             String?
  latitude          Decimal?        @db.Decimal(10, 6)
  longitude         Decimal?        @db.Decimal(10, 6)
  attemptedAt       DateTime        @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  routeStop RouteStop          @relation(fields: [tenantId, routeStopId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  package   Package            @relation(fields: [tenantId, packageId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  courier   Courier            @relation(fields: [tenantId, courierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  route     Route?             @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  evidence  DeliveryEvidence[]

  @@unique([tenantId, id])
  @@unique([tenantId, packageId, attemptNumber])
  @@index([tenantId])
  @@index([tenantId, routeStopId])
}

model DeliveryEvidence {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @db.Uuid
  deliveryAttemptId String   @db.Uuid
  evidenceType      String
  storageKey        String
  checksum          String
  byteSize          Int?
  mimeType          String?
  createdAt         DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  deliveryAttempt DeliveryAttempt @relation(fields: [tenantId, deliveryAttemptId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
}

model Incident {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @db.Uuid
  routeId          String?        @db.Uuid
  routeStopId      String?        @db.Uuid
  packageId        String?        @db.Uuid
  reportedByUserId String         @db.Uuid
  type             String
  description      String
  status           IncidentStatus @default(OPEN)
  reportedAt       DateTime       @default(now())

  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  route          Route?     @relation(fields: [tenantId, routeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  routeStop      RouteStop? @relation(fields: [tenantId, routeStopId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  package        Package?   @relation(fields: [tenantId, packageId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  reportedByUser User       @relation(fields: [tenantId, reportedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
}
