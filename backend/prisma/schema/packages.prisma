enum PackageState {
  REGISTERED
  CLASSIFIED
  PENDING_ASSIGNMENT
  ASSIGNED_TO_ROUTE
  READY_FOR_DISPATCH
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RESCHEDULED
  RETURN_PENDING
  RETURNED
  CANCELLED
}

enum PackagePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Package {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String          @db.Uuid
  addressId              String          @db.Uuid
  geocodingAttemptId     String?         @db.Uuid
  zoneId                 String?         @db.Uuid
  sectorId               String?         @db.Uuid
  shipmentTypeId         String          @db.Uuid
  trackingCode           String
  publicTrackingToken    String          @unique
  state                  PackageState    @default(REGISTERED)
  weightKg               Decimal         @db.Decimal(10, 3)
  lengthCm               Decimal         @db.Decimal(10, 2)
  widthCm                Decimal         @db.Decimal(10, 2)
  heightCm               Decimal         @db.Decimal(10, 2)
  volumeM3               Decimal         @db.Decimal(12, 6)
  priority               PackagePriority @default(NORMAL)
  deadline               DateTime?
  serviceDurationSeconds Int?
  senderName             String
  senderPhone            String
  senderEmail            String?
  recipientName          String
  recipientPhone         String
  recipientEmail         String?

  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  address          Address                 @relation(fields: [tenantId, addressId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  geocodingAttempt GeocodingAttempt?       @relation(fields: [tenantId, geocodingAttemptId, addressId], references: [tenantId, id, addressId], onDelete: Restrict, onUpdate: Restrict)
  zone             Zone?                   @relation(fields: [tenantId, zoneId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  sector           Sector?                 @relation(fields: [tenantId, sectorId, zoneId], references: [tenantId, id, zoneId], onDelete: Restrict, onUpdate: Restrict)
  shipmentType     ShipmentType            @relation(fields: [tenantId, shipmentTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  statusHistory    PackageStatusHistory[]
  assignments      Assignment[]
  deliveryAttempts DeliveryAttempt[]
  incidents        Incident[]
  deliveryWindows  DeliveryWindow[]
  planningResults  PlanningPackageResult[]

  @@unique([tenantId, id])
  @@unique([tenantId, trackingCode])
  @@index([tenantId])
}

model PackageStatusHistory {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @db.Uuid
  packageId       String        @db.Uuid
  fromState       PackageState?
  toState         PackageState
  reasonCode      String?
  changedByUserId String?       @db.Uuid
  createdAt       DateTime      @default(now())

  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  package       Package @relation(fields: [tenantId, packageId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  changedByUser User?   @relation(fields: [tenantId, changedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
}
