# Used by Prisma CLI (migrate, generate) — connects as the postgres superuser.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sls?schema=public"

# Used by the NestJS app at runtime — connects as sls_app, subject to Row-Level Security.
RUNTIME_DATABASE_URL="postgresql://sls_app:sls_app_dev_password@localhost:5432/sls?schema=public"

# RabbitMQ connection (infrastructure only for now — no publishers/consumers implemented yet).
RABBITMQ_URL="amqp://sls:sls@localhost:5672/sls"

# Used only by the tenant-provisioning use case — never by ordinary request handling.
PROVISIONING_DATABASE_URL="postgresql://sls_provisioning:sls_provisioning_dev_password@localhost:5432/sls?schema=public"
